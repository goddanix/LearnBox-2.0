<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- A widget extension is always sandboxed. Its one read: the snapshot folder the helper writes
       (the only way for a sandboxed extension to read a file outside its container, without an app group). -->
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
  <array><string>/Library/Application Support/Learnbox/widget/</string></array>
</dict></plist>
